{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ai-news-navigator-staging",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-16",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [
    {
      "pattern": "ailoresift.com",
      "custom_domain": true,
    },
    {
      "pattern": "www.ailoresift.com",
      "custom_domain": true,
    },
    {
      "pattern": "staging.ailoresift.com",
      "custom_domain": true,
    },
  ],
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://ailoresift.com",
    "DISTILL_OWNER_ID": "personal-owner",
    "DISTILL_GUEST_PROTECTION_MODE": "rate-limit",
    "DISTILL_GUEST_DAILY_MODEL_LIMIT": "200",
    "DATABASE_DRIVER": "neon-serverless",
    "DEEPSEEK_MODEL": "deepseek-v4-flash",
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "observability": {
    "enabled": true,
  },
}
