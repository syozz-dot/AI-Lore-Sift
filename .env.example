# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_news_navigator
# Leave empty for Postgres.js in Node/Vercel. Cloudflare Workers use the Neon
# serverless WebSocket driver to avoid direct PostgreSQL TCP setup.
DATABASE_DRIVER=

# Web
NEXT_PUBLIC_SITE_URL=http://localhost:3000
CRON_SECRET=
# Per warm server/edge instance. Public Story APIs also use short-lived response
# caching, so normal browsing stays well below this ceiling.
PUBLIC_API_REQUESTS_PER_MINUTE=180

# Private distill workspace. Use a random passphrase for DISTILL_ACCESS_KEY
# (12+ characters strongly recommended; 6 is the enforced legacy minimum) and
# an independent random secret of at least 32
# characters for DISTILL_SESSION_SECRET. Never reuse CRON_SECRET, database
# credentials, or a model-provider key. The first release is single-owner only.
DISTILL_ACCESS_KEY=
DISTILL_SESSION_SECRET=
DISTILL_OWNER_ID=personal-owner

# Public one-time Distill preview. Production requires an explicit protection
# mode. Use rate-limit when Turnstile is not a reliable client dependency (for
# example, Mainland China), and add a platform-level WAF rate limit as the
# globally consistent layer. The built-in limiter is only defense in depth.
DISTILL_GUEST_PROTECTION_MODE=rate-limit
DISTILL_GUEST_DAILY_MODEL_LIMIT=200

# Optional Turnstile mode. Set DISTILL_GUEST_PROTECTION_MODE=turnstile and
# configure both values. The public site key is safe to expose; keep the secret
# key only in the deployment environment.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional reader adapter used for protected article pages such as WeChat
# official accounts. The built-in endpoint works without a key at low volume;
# add JINA_API_KEY for a higher service quota.
DISTILL_READER_BASE_URL=https://r.jina.ai
JINA_API_KEY=

# Optional signed image proxy for X and WeChat media. CRON_SECRET is used as
# the fallback signing secret. Add trusted media hosts as a comma-separated
# list; the built-in list already covers pbs.twimg.com and mmbiz.qpic.cn.
MEDIA_PROXY_SECRET=
MEDIA_PROXY_ALLOWED_HOSTS=

# Story analysis. A direct DeepSeek key takes priority and uses V4 Flash in
# non-thinking JSON mode by default. Override the base URL for an OpenAI-
# compatible relay. Keep every key in your environment, never in Git.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# Optional direct OpenAI fallback.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-nano

# Optional fallback through Vercel AI Gateway. Production deployments receive
# VERCEL_OIDC_TOKEN automatically; use AI_GATEWAY_API_KEY only for local runs.
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=openai/gpt-5-nano

# Optional curated social sources. Sources are registered only when their
# required credential or feed URL exists, so leaving these blank is safe.
X_BEARER_TOKEN=
X_MONITORED_ACCOUNTS=OpenAI,AnthropicAI,GoogleDeepMind,MistralAI,huggingface,NVIDIAAI,xai,AIatMeta

# Point this at a private We-MP-RSS or compatible RSS endpoint. Keep the
# stateful collector outside Vercel; Vercel only consumes its feed.
WECHAT_RSS_URL=
WECHAT_RSS_AUTHORIZATION=
WECHAT_MONITORED_ACCOUNTS=机器之心,量子位,新智元,Founder Park,极客公园,差评X.PIN,AI科技评论,PaperWeekly

# Jobs
INGESTION_CONCURRENCY=4
LOG_LEVEL=info
